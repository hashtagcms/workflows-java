# Copy to `.env` — docker compose reads it automatically (for interpolation and,
# via env_file, injected into the container). Leave the datasource blank to run on
# in-memory H2. This project does NOT start its own MySQL; it connects to a
# database you already run.

# ---- Image / runtime -------------------------------------------------------
VERSION=1.0.1
HOST_PORT=8080
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
# Return real exception messages in API error responses (dev only — keep false in prod).
HASHTAGCMS_WORKFLOWS_EXPOSE_ERROR_DETAILS=false

# ==========================================================================
# Option A — Standalone against YOUR MySQL (Java owns/creates the schema)
# ==========================================================================
# Uncomment and adjust. `host.docker.internal` reaches a MySQL container that
# publishes 3306 on the host; or use its container name if on the same network.
#SPRING_DATASOURCE_URL=jdbc:mysql://host.docker.internal:3306/workflows?useSSL=false&allowPublicKeyRetrieval=true
#SPRING_DATASOURCE_USERNAME=root
#SPRING_DATASOURCE_PASSWORD=root_password
#SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
#SPRING_JPA_HIBERNATE_DDL_AUTO=update

# ==========================================================================
# Option B — Shared with the PHP app (existing HashtagCMS DB, PHP owns schema)
# ==========================================================================
# Runs the `shared` profile: validate-only (no table creation), no seeding,
# Sanctum-token auth. The PHP workflow tables must already exist in that database.
#SPRING_PROFILES_ACTIVE=shared
#DB_URL=jdbc:mysql://host.docker.internal:3306/v30?useSSL=false&allowPublicKeyRetrieval=true
#DB_USERNAME=root
#DB_PASSWORD=root_password
